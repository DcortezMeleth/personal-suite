module(
    name = "personal_suite",
    version = "0.0.0",
)

# ── Core ──────────────────────────────────────────────────────────────────────

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")

# ── Scala 3 backend ───────────────────────────────────────────────────────────

# Bazel 9 no longer provides java_library natively, and belFER's solver is
# written in Java. 9.3.0 is the version rules_scala and rules_jvm_external
# already resolve to, so this pins what is in the graph rather than adding to it.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_scala", version = "7.4.1")
bazel_dep(name = "rules_jvm_external", version = "7.2")

scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
# 3.3.x LTS, the line the Typelevel libraries below are published against.
# The exact patch is not free to choose — rules_scala pins one per release and
# fails the build if scala_config disagrees. The old cats TASTy crash that once
# held this back no longer reproduces; TECH_STACK.md has the history.
scala_config.settings(scala_version = "3.3.9")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()
scala_deps.scalatest()

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # HTTP server
        "org.http4s:http4s-core_3:0.23.39",
        "org.http4s:http4s-ember-server_3:0.23.39",
        "org.http4s:http4s-client_3:0.23.39",
        "org.http4s:http4s-ember-client_3:0.23.39",
        "org.http4s:http4s-circe_3:0.23.39",
        "org.http4s:http4s-dsl_3:0.23.39",
        "org.http4s:http4s-server_3:0.23.39",
        # Effect runtime. cats-core was held at 2.9.0 for a long time because
        # 2.12.0's TupleParallelSyntax had a TASTy encoding Scala 3 could not
        # read; that stopped reproducing under 3.3.8 and the pin is lifted.
        # See TECH_STACK.md before assuming it is safe to move again.
        "org.typelevel:cats-core_3:2.13.0",
        "org.typelevel:cats-free_3:2.13.0",
        "org.typelevel:cats-kernel_3:2.13.0",
        "org.typelevel:cats-effect_3:3.7.1",
        "org.typelevel:cats-effect-kernel_3:3.7.1",
        "org.typelevel:cats-effect-std_3:3.7.1",
        # fs2 streams (transitive via http4s Ember)
        "co.fs2:fs2-core_3:3.16.0",
        "co.fs2:fs2-io_3:3.16.0",
        # IP address helpers
        "com.comcast:ip4s-core_3:3.8.0",
        # JSON
        "io.circe:circe-core_3:0.14.17",
        "io.circe:circe-generic_3:0.14.17",
        "io.circe:circe-parser_3:0.14.17",
        # Database. doobie 1.0 is still a release candidate; RCs are the current line.
        "org.tpolecat:doobie-core_3:1.0.0-RC12",
        "org.tpolecat:doobie-free_3:1.0.0-RC12",
        "org.tpolecat:doobie-postgres_3:1.0.0-RC12",
        "org.tpolecat:doobie-hikari_3:1.0.0-RC12",
        "org.tpolecat:typename_3:1.1.2",
        "org.postgresql:postgresql:42.7.15",
        # Migrations (pure Java, no Scala version dependency)
        "org.flywaydb:flyway-core:13.13.0",
        "org.flywaydb:flyway-database-postgresql:13.13.0",
        # Logging
        "ch.qos.logback:logback-classic:1.6.8",
        "org.typelevel:log4cats-core_3:2.8.0",
        "org.typelevel:log4cats-slf4j_3:2.8.0",
        # Config
        "com.typesafe:config:1.4.10",
        # Explicitly pin transitive Scala 3 deps needed for compilation
        # (http4s-core transitively depends on all of these via opaque types)
        "org.typelevel:vault_3:3.7.0",
        "org.typelevel:cats-mtl_3:1.7.0",
        "org.typelevel:case-insensitive_3:1.5.0",
        "org.typelevel:literally_3:1.2.0",
        "org.typelevel:cats-parse_3:1.1.0",
        "org.typelevel:keypool_3:0.4.12",
        # Named rather than left to the resolver: logback and log4cats each
        # bring their own floor, and pinning it keeps one answer in the lock
        # file instead of whichever the graph happened to settle on.
        "org.slf4j:slf4j-api:2.0.20",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    strict_visibility = True,
    known_contributing_modules = ["protobuf"],
)
use_repo(maven, "maven")

# ── JavaScript / TypeScript frontend ──────────────────────────────────────────

bazel_dep(name = "aspect_rules_js", version = "3.6.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

typescript = use_extension(
    "@aspect_rules_ts//ts:extensions.bzl",
    "typescript",
    dev_dependency = True,
)
typescript.deps(
    version_from = "//:package.json",
)
use_repo(typescript, "npm_typescript")

# ── Container images ──────────────────────────────────────────────────────────

bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "temurin_jre",
    image = "eclipse-temurin",
    tag = "25-jre-noble",
    platforms = ["linux/amd64"],
)

# Both architectures, unlike the JRE below. The services ship linux/amd64 for
# Proxmox, but the frontend image is nginx and static files with no native code
# in it, so it can also be built for an arm64 laptop — which is the only way to
# start the app on a machine whose host node and node_modules disagree about
# their architecture.
oci.pull(
    name = "nginx_base",
    image = "nginx",
    tag = "1.27-alpine",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(
    oci,
    "temurin_jre",
    "temurin_jre_linux_amd64",
    "nginx_base",
    "nginx_base_linux_amd64",
    "nginx_base_linux_arm64_v8",
)
