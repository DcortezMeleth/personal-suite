module(
    name = "delfin_monorepo",
    version = "0.0.0",
)

# ── Core ──────────────────────────────────────────────────────────────────────

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "platforms", version = "1.0.0")

# ── Scala 3 backend ───────────────────────────────────────────────────────────

bazel_dep(name = "rules_scala", version = "7.2.5")
bazel_dep(name = "rules_jvm_external", version = "7.0")

scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
# 3.3.7 LTS: the http4s / cats-effect 3.5.x ecosystem was compiled against 3.3.x.
# Downgrading from 3.7.0 to 3.5.7 avoids the cats-core 2.12+ TupleParallelSyntax
# TASTy crash that affects all Scala 3 versions when reading cats 2.12+/2.13 TASTy.
scala_config.settings(scala_version = "3.3.7")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # HTTP server (0.23.30 = last release on cats-effect 3.5.x)
        "org.http4s:http4s-core_3:0.23.30",
        "org.http4s:http4s-ember-server_3:0.23.30",
        "org.http4s:http4s-ember-client_3:0.23.30",
        "org.http4s:http4s-circe_3:0.23.30",
        "org.http4s:http4s-dsl_3:0.23.30",
        "org.http4s:http4s-server_3:0.23.30",
        # Effect runtime — cats-core 2.9.0 avoids TupleParallelSyntax TASTy crash
        "org.typelevel:cats-core_3:2.9.0",
        "org.typelevel:cats-free_3:2.9.0",
        "org.typelevel:cats-kernel_3:2.9.0",
        "org.typelevel:cats-effect_3:3.5.7",
        "org.typelevel:cats-effect-kernel_3:3.5.7",
        "org.typelevel:cats-effect-std_3:3.5.7",
        # fs2 streams (transitive via http4s Ember)
        "co.fs2:fs2-core_3:3.10.2",
        "co.fs2:fs2-io_3:3.10.2",
        # IP address helpers
        "com.comcast:ip4s-core_3:3.4.0",
        # JSON
        "io.circe:circe-core_3:0.14.10",
        "io.circe:circe-generic_3:0.14.10",
        "io.circe:circe-parser_3:0.14.10",
        # Database (RC4 uses CE 3.5.0 + cats 2.9.0)
        "org.tpolecat:doobie-core_3:1.0.0-RC4",
        "org.tpolecat:doobie-free_3:1.0.0-RC4",
        "org.tpolecat:doobie-postgres_3:1.0.0-RC4",
        "org.tpolecat:doobie-hikari_3:1.0.0-RC4",
        "org.tpolecat:typename_3:1.1.0",
        "org.postgresql:postgresql:42.7.11",
        # Migrations (pure Java, no Scala version dependency)
        "org.flywaydb:flyway-core:12.8.0",
        "org.flywaydb:flyway-database-postgresql:12.8.0",
        # Logging
        "ch.qos.logback:logback-classic:1.5.34",
        "org.typelevel:log4cats-core_3:2.6.0",
        "org.typelevel:log4cats-slf4j_3:2.6.0",
        # Config
        "com.typesafe:config:1.4.3",
        # Explicitly pin transitive Scala 3 deps needed for compilation
        # (http4s-core transitively depends on all of these via opaque types)
        "org.typelevel:vault_3:3.5.0",
        "org.typelevel:cats-mtl_3:1.3.1",
        "org.typelevel:case-insensitive_3:1.4.0",
        "org.typelevel:literally_3:1.1.0",
        "org.typelevel:cats-parse_3:1.0.0",
        "org.typelevel:keypool_3:0.4.9",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    strict_visibility = True,
    known_contributing_modules = ["protobuf"],
)
use_repo(maven, "maven")

# ── JavaScript / TypeScript frontend ──────────────────────────────────────────

bazel_dep(name = "aspect_rules_js", version = "3.2.0")
bazel_dep(name = "aspect_rules_ts", version = "3.8.10")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension(
    "@aspect_rules_ts//ts:extensions.bzl",
    "ext",
    dev_dependency = True,
)
rules_ts_ext.deps(
    ts_version_from = "//:package.json",
)
use_repo(rules_ts_ext, "npm_typescript")

# ── Container images ──────────────────────────────────────────────────────────

bazel_dep(name = "rules_oci", version = "2.3.0")
