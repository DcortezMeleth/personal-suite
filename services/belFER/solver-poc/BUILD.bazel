load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")

# A spike, not a service. Each candidate gets the same instance and the same
# verifier, so the comparison rests on a solved timetable rather than on what
# the documentation promises.
#
# Timefold, Choco and a hand-rolled annealer were measured too and ruled out on
# a simpler version of this instance; their models are at commit e96a6d6 and
# the results are in docs/SOLVER_EVALUATION.md. They are not kept here because
# carrying them forward would mean writing all sixteen rules three more times
# for engines already eliminated.
#
# Nothing here is on belFER's classpath: the service depends on //services/
# belFER/backend:solver, never on this package.

java_library(
    name = "model",
    srcs = [
        "src/main/java/poc/Instance.java",
        "src/main/java/poc/Verifier.java",
    ],
    visibility = ["//visibility:private"],
)



# ── OR-Tools CP-SAT ──────────────────────────────────────────────────────────
# Not a JVM library: ortools-java is a thin wrapper and the solver itself is a
# native binary, so the runtime dependency is per-platform. The darwin-x86-64
# artifact is what this toolchain needs; a Linux image needs a different one.
java_binary(
    name = "ortools",
    srcs = glob(["src/main/java/poc/ortools/*.java"]),
    main_class = "poc.ortools.OrToolsMain",
    deps = [
        ":model",
        "@maven//:com_google_ortools_ortools_java",
        "@maven//:com_google_protobuf_protobuf_java",
    ],
    # No per-platform select here, and that is worth knowing rather than
    # tidying: ortools-java declares every platform's native artifact as a
    # dependency, so all five arrive transitively whatever you ask for and the
    # Loader picks the right one at runtime. Convenient, but it means ~106 MB
    # of native libraries ship when one is needed — Windows included.
    runtime_deps = ["@maven//:com_google_ortools_ortools_java"],
)

# ── Proving CP-SAT runs where it would actually be deployed ──────────────────
# The POC passing on a Mac says nothing about a Linux container, and a native
# dependency is exactly the kind that works on one and not the other. Same
# cross-build the backend image uses, for the same reason: the binary embeds a
# JDK, so a host build would ship a macOS JVM inside a Linux image.
platform_transition_filegroup(
    name = "ortools_linux_amd64",
    srcs = [":ortools"],
    target_platform = "//platforms:linux_amd64",
)

pkg_tar(
    name = "ortools_layer",
    srcs = [":ortools_linux_amd64"],
    include_runfiles = True,
    package_dir = "/app",
)

oci_image(
    name = "ortools_image",
    base = "@temurin_jre",
    tars = [":ortools_layer"],
    entrypoint = ["/app/ortools"],
    env = {
        "JAVA_RUNFILES": "/app/ortools.jar.runfiles",
        "TEST_SRCDIR": "/app/ortools.jar.runfiles",
    },
)

oci_load(
    name = "ortools_image_load",
    image = ":ortools_image",
    repo_tags = ["belfer-solver-poc:local"],
)

# ── JaCoP ────────────────────────────────────────────────────────────────────
# The pure-JVM alternative: no native binary, no per-platform artifact.
java_binary(
    name = "jacop",
    srcs = glob(["src/main/java/poc/jacop/*.java"]),
    main_class = "poc.jacop.JacopMain",
    deps = [
        ":model",
        "@maven//:org_jacop_jacop",
    ],
)

