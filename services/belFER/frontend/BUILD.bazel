load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@npm//services/belFER/frontend:vite/package_json.bzl", vite_bin = "bin")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "app_ts",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-calendar",
        ":node_modules/react-dom",
        ":node_modules/react-router-dom",
        ":node_modules/@delfin/ui",
    ],
    # tsconfig.base.json sets noEmit: true — this is a pure type-check gate,
    # producing no .js or .d.ts at all. Vite (below) transpiles the actual JS
    # straight from these .ts/.tsx sources.
    #
    # declaration/declaration_map/source_map look redundant beside no_emit, but
    # rules_ts validates that these attributes mirror tsconfig.base.json and
    # fails the build when they drift — so they stay.
    declaration = True,
    declaration_map = True,
    source_map = True,
    resolve_json_module = True,
    no_emit = True,
    visibility = ["//visibility:private"],
)

# With no_emit, rules_ts puts the type check in an output group rather than in
# the target's default outputs — so :app_ts alone builds nothing, and Bazel
# never runs an action that produces nothing. The check reported success on
# every build while never once running.
#
# Naming the group here turns it into a real file, and listing it in the Vite
# build below makes a type error fail the build that matters.
#
# rules_ts also generates :app_ts_typecheck_test, which `bazel test //...`
# picks up. That is the idiomatic route and it works, but it only guards the
# test command — this filegroup is what stops `bazel build` from emitting a
# bundle that does not type-check.
filegroup(
    name = "app_typecheck",
    srcs = [":app_ts"],
    output_group = "typecheck",
    visibility = ["//visibility:private"],
)

vite_bin.vite(
    name = "build",
    args = ["build"],
    chdir = package_name(),
    srcs = [
        # :app_ts is a pure type-check gate (no_emit) — kept here so a type
        # error fails this build too, but Vite reads these raw sources itself
        # (it does its own transpiling), hence the glob alongside it.
        ":app_ts",
        ":app_typecheck",
        "index.html",
        "postcss.config.js",
        "vite.config.ts",
        ":node_modules/vite",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/@tailwindcss/postcss",
        ":node_modules/tailwindcss",
        "//libs/ui:ui",
    ] + glob(["src/**"]) + glob(["public/**"], allow_empty = True),
    out_dirs = ["dist"],
    visibility = ["//visibility:public"],
)

# No container image yet, unlike delFIN's frontend. nginx needs a config naming
# the backend host and port, and there is nothing to deploy until Phase 1 puts
# real screens here — so packaging waits until it buys something.

# ── The app, in a container ───────────────────────────────────────────────────
#
# A built bundle behind nginx, the same shape delFIN uses. It exists for two
# reasons beyond deployment: it is what the home lab will run, and it is the
# only way to start the app on a machine whose node and node_modules disagree
# about their architecture — inside the image they match by construction.
#
# nginx needs no runtime of its own here: Vite has already turned the sources
# into files, and serving files is all that is left.
pkg_tar(
    name = "dist_layer",
    srcs = [":build"],
    strip_prefix = "dist",
    package_dir = "/usr/share/nginx/html",
)

# belFER's own nginx config rather than delFIN's: its backend mounts /api
# itself and answers /health at the root, so the two proxy differently.
# Into /etc/nginx/templates rather than conf.d: the nginx image's entrypoint
# runs envsubst over anything it finds there and writes the result to conf.d,
# which is how the backend's address becomes a run-time choice.
pkg_tar(
    name = "nginx_conf_layer",
    srcs = ["//infra/nginx:belfer.conf.template"],
    package_dir = "/etc/nginx/templates",
    remap_paths = {"/belfer.conf.template": "/default.conf.template"},
)

oci_image(
    name = "frontend_image",
    base = "@nginx_base",
    tars = [
        ":dist_layer",
        ":nginx_conf_layer",
    ],
    exposed_ports = ["80"],
    env = {"BELFER_BACKEND": "http://belfer-backend:8081"},
)

oci_load(
    name = "frontend_image_load",
    image = ":frontend_image",
    repo_tags = ["belfer-frontend:local"],
)

# The same bundle on an arm64 nginx, so the app can be started on an Apple
# laptop. No platform transition: a transition would rebuild the whole graph
# for Linux, Vite included, and Vite is a host tool. Only the base differs,
# and nothing in a bundle of HTML and JavaScript cares what it runs on.
oci_image(
    name = "frontend_image_arm64",
    base = "@nginx_base_linux_arm64_v8",
    tars = [
        ":dist_layer",
        ":nginx_conf_layer",
    ],
    exposed_ports = ["80"],
    env = {"BELFER_BACKEND": "http://belfer-backend:8081"},
)

oci_load(
    name = "frontend_image_load_arm64",
    image = ":frontend_image_arm64",
    repo_tags = ["belfer-frontend:local-arm64"],
)
