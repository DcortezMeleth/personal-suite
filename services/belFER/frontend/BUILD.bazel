load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//services/belFER/frontend:vite/package_json.bzl", vite_bin = "bin")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "app_ts",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-calendar",
        ":node_modules/react-dom",
        ":node_modules/react-router-dom",
        ":node_modules/@delfin/ui",
    ],
    # tsconfig.base.json sets noEmit: true — this is a pure type-check gate,
    # producing no .js or .d.ts at all. Vite (below) transpiles the actual JS
    # straight from these .ts/.tsx sources.
    #
    # declaration/declaration_map/source_map look redundant beside no_emit, but
    # rules_ts validates that these attributes mirror tsconfig.base.json and
    # fails the build when they drift — so they stay.
    declaration = True,
    declaration_map = True,
    source_map = True,
    resolve_json_module = True,
    no_emit = True,
    visibility = ["//visibility:private"],
)

# With no_emit, rules_ts puts the type check in an output group rather than in
# the target's default outputs — so :app_ts alone builds nothing, and Bazel
# never runs an action that produces nothing. The check reported success on
# every build while never once running.
#
# Naming the group here turns it into a real file, and listing it in the Vite
# build below makes a type error fail the build that matters.
filegroup(
    name = "app_typecheck",
    srcs = [":app_ts"],
    output_group = "typecheck",
    visibility = ["//visibility:private"],
)

vite_bin.vite(
    name = "build",
    args = ["build"],
    chdir = package_name(),
    srcs = [
        # :app_ts is a pure type-check gate (no_emit) — kept here so a type
        # error fails this build too, but Vite reads these raw sources itself
        # (it does its own transpiling), hence the glob alongside it.
        ":app_ts",
        ":app_typecheck",
        "index.html",
        "tailwind.config.js",
        "postcss.config.js",
        "vite.config.ts",
        ":node_modules/vite",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/tailwindcss",
        ":node_modules/autoprefixer",
        "//libs/ui:ui",
    ] + glob(["src/**"]) + glob(["public/**"], allow_empty = True),
    out_dirs = ["dist"],
    visibility = ["//visibility:public"],
)

# No container image yet, unlike delFIN's frontend. nginx needs a config naming
# the backend host and port, and there is nothing to deploy until Phase 1 puts
# real screens here — so packaging waits until it buys something.
