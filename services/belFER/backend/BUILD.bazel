        "@maven//:org_typelevel_cats_effect_kernel_3",
        "@maven//:org_typelevel_cats_effect_std_3",
        "@maven//:org_typelevel_cats_kernel_3",
        "@maven//:org_typelevel_log4cats_core_3",
        "@maven//:org_typelevel_log4cats_slf4j_3",
        "@maven//:co_fs2_fs2_core_3",
        "@maven//:co_fs2_fs2_io_3",
