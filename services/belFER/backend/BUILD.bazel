# ── Container image ─────────────────────────────────────────────────────────
# Mirrors the delFIN backend's packaging, including two workarounds that are
# not obvious and should not be "simplified" away:
#
#  * platform_transition_filegroup cross-builds :server for linux/amd64. The
#    binary embeds a JDK, so a host build on darwin/arm64 would ship a macOS
#    JVM inside a Linux image. Using a global --platforms flag instead would
#    drag the host-side tar/docker-load tooling onto the wrong platform too.
#
#  * The env block names the runfiles directory explicitly. pkg_tar's
#    include_runfiles names it after the jar (server.jar.runfiles), not the
#    launcher, so the launcher's self-detection looks in the wrong place.
#    Both vars are needed: JAVA_RUNFILES builds the classpath and TEST_SRCDIR
#    locates the JVM, and TEST_SRCDIR is only derived from JAVA_RUNFILES inside
#    the auto-detect block that presetting JAVA_RUNFILES skips.

platform_transition_filegroup(
    name = "server_linux_amd64",
    srcs = [":server"],
    target_platform = "//platforms:linux_amd64",
)

pkg_tar(
    name = "server_layer",
    srcs = [":server_linux_amd64"],
    include_runfiles = True,
    package_dir = "/app",
)

oci_image(
    name = "server_image",
    base = "@temurin_jre",
    tars = [":server_layer"],
    entrypoint = ["/app/server"],
    env = {
        "JAVA_RUNFILES": "/app/server.jar.runfiles",
        "TEST_SRCDIR": "/app/server.jar.runfiles",
    },
    exposed_ports = ["8081"],
)

oci_load(
    name = "server_image_load",
    image = ":server_image",
    repo_tags = ["belfer-backend:local"],
)

scala_test(
    name = "unit_test",
    srcs = glob(["src/test/scala/**/*.scala"]),
    resources = ["//services/belFER/testdata:testdata"],
    deps = [
        ":belfer_lib",
        ":solver",
        "@maven//:ai_timefold_solver_timefold_solver_core",
        "@maven//:org_tpolecat_doobie_core_3",
        "@maven//:org_typelevel_cats_effect_3",
    ],
)
