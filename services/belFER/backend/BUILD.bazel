        "@maven//:org_postgresql_postgresql",
        "@maven//:org_tpolecat_doobie_core_3",
        "@maven//:org_tpolecat_doobie_free_3",
        "@maven//:org_tpolecat_doobie_hikari_3",
        "@maven//:org_tpolecat_doobie_postgres_3",
        "@maven//:org_tpolecat_typename_3",
        "@maven//:org_typelevel_cats_core_3",
        "@maven//:org_typelevel_cats_free_3",
