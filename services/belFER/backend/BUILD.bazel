load("@rules_java//java:defs.bzl", "java_library")
load("@rules_scala//scala:scala.bzl", "scala_binary", "scala_library", "scala_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")

# Warnings we want to read rather than count.
#
# Scala's default rolls deprecations into a tally — "36 deprecation warnings;
# re-run with -deprecation" — and that is exactly how thirty-six calls to a
# method http4s had renamed sat unnoticed through several upgrades. -Wunused
# turned up twenty-three more pieces of dead code the same afternoon: imports
# of types no longer referenced, parameters nothing read, a lookup table built
# and never consulted.
#
# All of it is at zero now, which is the only state worth defending: one
# warning is a thing you fix, forty is a thing you scroll past.
SCALACOPTS = ["-deprecation", "-feature", "-Wunused:all"]

# The solver lives in Java, not Scala. CP-SAT's API is heavily generic and its
# model is built by mutation, both of which are unpleasant from Scala 3 — and
# keeping it here means no solver type ever crosses into the Scala side. The
# boundary is plain records (TimetableProblem / TimetableSolution), so changing
# engine touches this module alone. ADR 0001 is why that mattered: the engine
# already changed once.
#
# ADR 0004 changed it again, to FET. This is kept — it solves the smaller
# instances, it is the only thing that can express "first or last, whichever
# suits", and it is a second opinion when FET struggles — but nothing the
# server serves reaches it, so only :cpsat_lib and the tests depend on it.
# ortools-java drags in every platform's native artifact, which is a great
# deal of shared library to ship in an image that would never load it.
java_library(
    name = "solver",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "@maven//:com_google_ortools_ortools_java",
        "@maven//:com_google_protobuf_protobuf_java",
    ],
    visibility = ["//visibility:public"],
)

# The dependency list mirrors //services/delFIN/backend:fin_lib. rules_jvm_external
# does not place transitive dependencies on the scalac classpath, so every type
# visible during compilation has to be named here — see TECH_STACK.md. That list
# was arrived at the hard way, so it is reused wholesale rather than rediscovered.
# Everything the server is. The CP-SAT sources are excluded rather than
# deleted: see :cpsat_lib below, and ADR 0004 for why they still exist at all.
scala_library(
    name = "belfer_lib",
    scalacopts = SCALACOPTS,
    srcs = glob(
        ["src/main/scala/**/*.scala"],
        exclude = [
            "src/main/scala/bel/solver/CpSatInput.scala",
