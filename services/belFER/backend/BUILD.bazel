# The CP-SAT engine and the command line that drives it, apart from the server.
#
# ADR 0004 says our solver is not deleted, and it is not. But "kept" and
# "linked into the thing the school runs" are different promises: ortools-java
# declares every platform's native artifact as a dependency, so all four arrive
# whatever is asked for, and until this split they arrived inside the server
# image to sit there unloaded. The server reaches none of this code — generation
# is still SolveCli only — so the only cost of separating them is this target.
scala_library(
    name = "cpsat_lib",
    scalacopts = SCALACOPTS,
    srcs = [
        "src/main/scala/bel/solver/CpSatInput.scala",
        "src/main/scala/bel/solver/SolveCli.scala",
    ],
    deps = [
        ":belfer_lib",
        ":solver",
        "@maven//:com_google_ortools_ortools_java",
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:com_comcast_ip4s_core_3",
        "@maven//:com_typesafe_config",
        "@maven//:io_circe_circe_core_3",
        "@maven//:io_circe_circe_generic_3",
        "@maven//:io_circe_circe_parser_3",
        "@maven//:org_flywaydb_flyway_core",
        "@maven//:org_flywaydb_flyway_database_postgresql",
        "@maven//:org_http4s_http4s_circe_3",
        "@maven//:org_http4s_http4s_core_3",
        "@maven//:org_http4s_http4s_dsl_3",
        "@maven//:org_http4s_http4s_client_3",
        "@maven//:org_http4s_http4s_ember_client_3",
        "@maven//:org_http4s_http4s_ember_server_3",
