load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")

# The solver lives in Java, not Scala. Timefold's planning domain is annotation-
# and JavaBean-driven and its ConstraintStreams API is heavily generic — both
# are unpleasant from Scala 3. Keeping the whole engine in Java avoids that, and
# means no Timefold type ever crosses into the Scala side: the boundary is plain
# DTOs, so replacing the solver later touches this module alone.
java_library(
    name = "solver",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["@maven//:ai_timefold_solver_timefold_solver_core"],
    visibility = ["//visibility:public"],
)

# The dependency list mirrors //services/delFIN/backend:fin_lib. rules_jvm_external
