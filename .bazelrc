# Enable bzlmod (default in Bazel 7+, explicit here for clarity)
common --enable_bzlmod

# Java 25 toolchain (current LTS). Scala 3.3.7, Timefold and the whole test
# suite were verified on it before the move.
build --java_runtime_version=25
build --tool_java_runtime_version=25
build --java_language_version=25

# Disable Java header compilation so Bazel passes full JARs to scalac.
# rules_jvm_external otherwise produces stripped header jars that lose Scala 3
# TASTy metadata, causing AssertionErrors in the dotty compiler.
build --nojava_header_compilation

# Show errors in tests
test --test_output=errors

# Avoid sandbox issues with pnpm on macOS
build --sandbox_writable_path=/private/tmp

# Fetch base images anonymously rather than through the host's credential
# helper. See tools/docker/README.md — a leftover "credsStore": "desktop" makes
# rules_oci fail on public images that need no credentials.
build --repo_env=DOCKER_CONFIG=%workspace%/tools/docker
