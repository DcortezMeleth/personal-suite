# A template rather than a finished config: nginx's entrypoint substitutes
# ${BELFER_BACKEND} at start-up, so the same image serves a compose stack
# (http://belfer-backend:8081) and a laptop whose backend is on the host
# (http://host.docker.internal:8081).
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # belFER's backend mounts /api itself, so the prefix is passed through
    # rather than stripped. delFIN's config does the opposite — its backend
    # serves the routes at the root — which is why the two cannot share a file.
    location /api/ {
        proxy_pass ${BELFER_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # Laying out a week is a request that waits, not a job that is polled,
        # and nginx's default would cut it off at sixty seconds. Measured on
        # the real school: thirty-five seconds one day and a hundred and
        # fifteen the next, for the same twenty-five classes — FET's search
        # does not take a predictable amount of time, and the plan it was
        # still working on would have been saved by the backend while the
        # browser was told the gateway timed out.
        #
        # Matched to belfer.fet.timeout, which is the real bound. If that is
        # raised — and asking FET to optimise rather than merely satisfy will
        # raise it — this has to move with it, or the answer is thrown away
        # on the way back.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # /health sits at the root so a readiness probe does not depend on the API
    # routes being wired up, which means it needs saying here separately.
    location /health {
        proxy_pass ${BELFER_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Anything else is the application: a path like /plan is a route inside it
    # rather than a file, so it gets index.html and React decides.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
