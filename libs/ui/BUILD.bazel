load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "ui_ts",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/react",
        ":node_modules/react-calendar",
    ],
    # tsconfig.base.json sets noEmit: true — this is a pure type-check gate,
    # producing no .js or .d.ts at all. The actual JS comes from the frontend's
    # own Vite build (see vite.config.ts's alias to these sources directly).
    declaration = True,
    declaration_map = True,
    source_map = True,
    resolve_json_module = True,
    no_emit = True,
    visibility = ["//visibility:public"],
)

js_library(
    name = "ui",
    # :ui_ts is a pure type-check gate (no_emit) and produces no files itself —
    # consumers (the frontend's Vite build) read these raw .ts/.tsx sources
    # directly via vite.config.ts's alias, so they must be included here too.
    #
    # The .css glob matters as much as the sources: MonthPicker imports
    # ./calendar.css, and without it here the file never reaches the sandbox,
    # so Vite fails to resolve the import. It is not in :ui_ts because
    # TypeScript has no business type-checking a stylesheet.
    srcs = [":ui_ts"] + glob(["src/**/*.ts", "src/**/*.tsx", "src/**/*.css"]),
    visibility = ["//visibility:public"],
)

# Linked into each frontend's node_modules as @delfin/ui, which is how its
# consumers already declare it in package.json.
#
# Without this the only route to these sources was a tsconfig `paths` mapping
# to a relative file path, which Vite honoured and tsc could not resolve inside
# the Bazel sandbox — so every import of @delfin/ui was an unchecked `any`.
npm_package(
    name = "pkg",
    # package.json is not optional here: it carries the "exports" map that
    # points at src/index.ts, which is how tsc and Vite both find the entry
    # point. Without it the linked package is a directory of orphan files.
    srcs = [
        "package.json",
        ":ui",
    ],
    package = "@delfin/ui",
    visibility = ["//visibility:public"],
)
