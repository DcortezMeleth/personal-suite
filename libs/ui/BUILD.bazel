load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "ui_ts",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/react",
        ":node_modules/react-calendar",
    ],
    # tsconfig.base.json sets noEmit: true — this is a pure type-check gate,
    # producing no .js or .d.ts at all. The actual JS comes from the frontend's
    # own Vite build (see vite.config.ts's alias to these sources directly).
    declaration = True,
    declaration_map = True,
    source_map = True,
    resolve_json_module = True,
    no_emit = True,
    visibility = ["//visibility:public"],
)

js_library(
    name = "ui",
    # :ui_ts is a pure type-check gate (no_emit) and produces no files itself —
    # consumers (the frontend's Vite build) read these raw .ts/.tsx sources
    # directly via vite.config.ts's alias, so they must be included here too.
    srcs = [":ui_ts"] + glob(["src/**/*.ts", "src/**/*.tsx"]),
    visibility = ["//visibility:public"],
)
